#version 450

// GPU port of transformGeneric() in src/imageproc/Transform.cpp. Compiled once per pixel format:
// FORMAT_GRAY (8 bit, 4 pixels per uint), FORMAT_RGB (integer mixing) and FORMAT_ARGB (float mixing).

layout(local_size_x = 16, local_size_y = 16) in;

layout(std140, binding = 0) uniform Params {
  int srcWidth;
  int srcHeight;
  int srcStride;
  int srcRowBegin;
  int srcRowCount;
  int dstWidth;
  int dstStride;
  int bandRows;
  int unitWidth;
  int unitHeight;
  int outsideFlags;
  uint outsideColor;
} params;

layout(std430, binding = 1) readonly buffer SrcBuffer {
  uint src[];
};

layout(std430, binding = 2) writeonly buffer DstBuffer {
  uint dst[];
};

// Per column and per band row: x and y offsets in 1/32 pixel units as 32.32 fixed point
// (hi, lo, hi, lo), then a word with bit 0 / bit 1 set if the x / y offset is exact.
layout(std430, binding = 3) readonly buffer ColBuffer {
  uint cols[];
};

layout(std430, binding = 4) readonly buffer RowBuffer {
  uint rows[];
};

// status[0]: set on an out of band read. status[1 + row]: the row must be recomputed on the CPU.
layout(std430, binding = 5) buffer StatusBuffer {
  uint status[];
};

const int OUTSIDE_COLOR = 1;
const int OUTSIDE_WEAK = 4;
const int COORD_WORDS = 5;

// The CPU computes the coordinates in double precision. A fixed point sum within this distance
// (2^-24) of an integer may truncate differently, so such a row is recomputed on the CPU.
const uint MARGIN = 256u;

bool unsure = false;

int coord32(uint rowHi, uint rowLo, uint colHi, uint colLo, bool exact) {
  uint lo = rowLo + colLo;
  int hi = int(rowHi) + int(colHi) + (lo < rowLo ? 1 : 0);
  if (!exact && (lo < MARGIN || lo > 0xffffffffu - MARGIN)) {
    unsure = true;
  }
  return (hi < 0 && lo != 0u) ? hi + 1 : hi;
}

uint fetch(int x, int y) {
  int row = y - params.srcRowBegin;
  if (row < 0 || row >= params.srcRowCount) {
    status[0] = 1u;
    return 0u;
  }
#ifdef FORMAT_GRAY
  return (src[row * params.srcStride + (x >> 2)] >> (uint(x & 3) * 8u)) & 0xffu;
#else
  return src[row * params.srcStride + x];
#endif
}

#if defined(FORMAT_ARGB)
float accA;
float accR;
float accG;
float accB;

void mixReset() {
  accA = 0.0;
  accR = 0.0;
  accG = 0.0;
  accB = 0.0;
}

void mixAdd(uint c, uint weight) {
  float alphaWeight = float((c >> 24) & 0xffu) * float(weight);
  accA += alphaWeight;
  accR += float((c >> 16) & 0xffu) * alphaWeight;
  accG += float((c >> 8) & 0xffu) * alphaWeight;
  accB += float(c & 0xffu) * alphaWeight;
}

uint mixResult(uint totalWeight) {
  if (accA == 0.0) {
    return 0u;
  }
  float scale1 = 1.0 / float(totalWeight);
  float scale2 = 1.0 / accA;
  uint a = uint(0.5 + accA * scale1);
  uint r = uint(0.5 + accR * scale2);
  uint g = uint(0.5 + accG * scale2);
  uint b = uint(0.5 + accB * scale2);
  return (a << 24) | (r << 16) | (g << 8) | b;
}
#elif defined(FORMAT_RGB)
uint accR;
uint accG;
uint accB;

void mixReset() {
  accR = 0u;
  accG = 0u;
  accB = 0u;
}

void mixAdd(uint c, uint weight) {
  accR += ((c >> 16) & 0xffu) * weight;
  accG += ((c >> 8) & 0xffu) * weight;
  accB += (c & 0xffu) * weight;
}

uint mixResult(uint totalWeight) {
  uint halfWeight = totalWeight >> 1;
  uint r = (accR + halfWeight) / totalWeight;
  uint g = (accG + halfWeight) / totalWeight;
  uint b = (accB + halfWeight) / totalWeight;
  return 0xff000000u | (r << 16) | (g << 8) | b;
}
#else
uint acc;

void mixReset() {
  acc = 0u;
}

void mixAdd(uint c, uint weight) {
  acc += c * weight;
}

uint mixResult(uint totalWeight) {
  return ((acc + (totalWeight >> 1)) / totalWeight) & 0xffu;
}
#endif

uint nearestInside(int srcLeft, int srcTop, int srcRight, int srcBottom) {
  if ((params.outsideFlags & OUTSIDE_COLOR) != 0) {
    return params.outsideColor;
  }
  int srcX = clamp((srcLeft + srcRight) >> 1, 0, params.srcWidth - 1);
  int srcY = clamp((srcTop + srcBottom) >> 1, 0, params.srcHeight - 1);
  return fetch(srcX, srcY);
}

uint transformPixel(int dx, int bandRow) {
  int rowBase = bandRow * COORD_WORDS;
  int colBase = dx * COORD_WORDS;
  uint exact = rows[rowBase + 4] & cols[colBase + 4];
  int sw = params.srcWidth;
  int sh = params.srcHeight;

  int src32Left = coord32(rows[rowBase], rows[rowBase + 1], cols[colBase], cols[colBase + 1], (exact & 1u) != 0u)
                  - (params.unitWidth >> 1);
  int src32Top = coord32(rows[rowBase + 2], rows[rowBase + 3], cols[colBase + 2], cols[colBase + 3],
                         (exact & 2u) != 0u)
                 - (params.unitHeight >> 1);
  int src32Right = src32Left + params.unitWidth;
  int src32Bottom = src32Top + params.unitHeight;
  int srcLeft = src32Left >> 5;
  int srcRight = (src32Right - 1) >> 5;
  int srcTop = src32Top >> 5;
  int srcBottom = (src32Bottom - 1) >> 5;

  if (srcBottom < 0 || srcRight < 0 || srcLeft >= sw || srcTop >= sh) {
    return nearestInside(srcLeft, srcTop, srcRight, srcBottom);
  }

  uint backgroundArea = 0u;

  if (srcTop < 0) {
    uint topFraction = uint(32 - (src32Top & 31));
    uint horFraction = uint(src32Right - src32Left);
    backgroundArea += topFraction * horFraction;
    uint fullPixelsVer = uint(-1 - srcTop);
    backgroundArea += horFraction * (fullPixelsVer << 5);
    srcTop = 0;
    src32Top = 0;
  }
  if (srcBottom >= sh) {
    uint bottomFraction = uint(src32Bottom - (srcBottom << 5));
    uint horFraction = uint(src32Right - src32Left);
    backgroundArea += bottomFraction * horFraction;
    uint fullPixelsVer = uint(srcBottom - sh);
    backgroundArea += horFraction * (fullPixelsVer << 5);
    srcBottom = sh - 1;
    src32Bottom = sh << 5;
  }
  if (srcLeft < 0) {
    uint leftFraction = uint(32 - (src32Left & 31));
    uint vertFraction = uint(src32Bottom - src32Top);
    backgroundArea += leftFraction * vertFraction;
    uint fullPixelsHor = uint(-1 - srcLeft);
    backgroundArea += vertFraction * (fullPixelsHor << 5);
    srcLeft = 0;
    src32Left = 0;
  }
  if (srcRight >= sw) {
    uint rightFraction = uint(src32Right - (srcRight << 5));
    uint vertFraction = uint(src32Bottom - src32Top);
    backgroundArea += rightFraction * vertFraction;
    uint fullPixelsHor = uint(srcRight - sw);
    backgroundArea += vertFraction * (fullPixelsHor << 5);
    srcRight = sw - 1;
    src32Right = sw << 5;
  }

  mixReset();
  if ((params.outsideFlags & OUTSIDE_WEAK) != 0) {
    backgroundArea = 0u;
  } else {
    mixAdd(params.outsideColor, backgroundArea);
  }

  uint leftFraction = uint(32 - (src32Left & 31));
  uint topFraction = uint(32 - (src32Top & 31));
  uint rightFraction = uint(src32Right - (srcRight << 5));
  uint bottomFraction = uint(src32Bottom - (srcBottom << 5));

  uint srcArea = uint(src32Bottom - src32Top) * uint(src32Right - src32Left);
  if (srcArea == 0u) {
    return nearestInside(srcLeft, srcTop, srcRight, srcBottom);
  }

  if (srcTop == srcBottom) {
    if (srcLeft == srcRight) {
      uint c = fetch(srcLeft, srcTop);
      if (backgroundArea == 0u) {
        return c;
      }
      mixAdd(c, srcArea);
    } else {
      uint vertFraction = uint(src32Bottom - src32Top);
      mixAdd(fetch(srcLeft, srcTop), vertFraction * leftFraction);
      for (int sx = srcLeft + 1; sx < srcRight; ++sx) {
        mixAdd(fetch(sx, srcTop), vertFraction << 5);
      }
      mixAdd(fetch(srcRight, srcTop), vertFraction * rightFraction);
    }
  } else if (srcLeft == srcRight) {
    uint horFraction = uint(src32Right - src32Left);
    mixAdd(fetch(srcLeft, srcTop), horFraction * topFraction);
    for (int sy = srcTop + 1; sy < srcBottom; ++sy) {
      mixAdd(fetch(srcLeft, sy), horFraction << 5);
    }
    mixAdd(fetch(srcLeft, srcBottom), horFraction * bottomFraction);
  } else {
    mixAdd(fetch(srcLeft, srcTop), topFraction * leftFraction);
    for (int sx = srcLeft + 1; sx < srcRight; ++sx) {
      mixAdd(fetch(sx, srcTop), topFraction << 5);
    }
    mixAdd(fetch(srcRight, srcTop), topFraction * rightFraction);

    for (int sy = srcTop + 1; sy < srcBottom; ++sy) {
      mixAdd(fetch(srcLeft, sy), leftFraction << 5);
      for (int sx = srcLeft + 1; sx < srcRight; ++sx) {
        mixAdd(fetch(sx, sy), 32u * 32u);
      }
      mixAdd(fetch(srcRight, sy), rightFraction << 5);
    }

    mixAdd(fetch(srcLeft, srcBottom), bottomFraction * leftFraction);
    for (int sx = srcLeft + 1; sx < srcRight; ++sx) {
      mixAdd(fetch(sx, srcBottom), bottomFraction << 5);
    }
    mixAdd(fetch(srcRight, srcBottom), bottomFraction * rightFraction);
  }

  return mixResult(srcArea + backgroundArea);
}

void main() {
  int bandRow = int(gl_GlobalInvocationID.y);
  int x = int(gl_GlobalInvocationID.x);
#ifdef FORMAT_GRAY
  int firstPixel = x * 4;
  if (bandRow >= params.bandRows || firstPixel >= params.dstWidth) {
    return;
  }
  uint packed = 0u;
  for (int i = 0; i < 4; ++i) {
    if (firstPixel + i < params.dstWidth) {
      packed |= transformPixel(firstPixel + i, bandRow) << (uint(i) * 8u);
    }
  }
  dst[bandRow * params.dstStride + x] = packed;
#else
  if (bandRow >= params.bandRows || x >= params.dstWidth) {
    return;
  }
  dst[bandRow * params.dstStride + x] = transformPixel(x, bandRow);
#endif
  if (unsure) {
    status[1 + bandRow] = 1u;
  }
}
